[includeIf "gitdir:~/Projects/Work/"]
    path = .gitconfig-work
[includeIf "gitdir:~/Projects/Personal/"]
    path = .gitconfig-play
[diff]
	tool = opendiff
[difftool "opendiff"]
	cmd = opendiff "$LOCAL" "$REMOTE"
[mergetool "opendiff"]
	cmd = opendiff "$LOCAL" "$REMOTE" -ancestor "$BASE" -merge "$MERGED"
	trustExitCode = true